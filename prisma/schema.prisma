generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  parentId Int?
  parent   Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  order    Int       @default(0)
  visible  Boolean   @default(true)
  image    String?   // Optional logo/photo for the category (used in storefront grid + mega-menu)
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  logo     String?
  visible  Boolean   @default(true)
  products Product[]
}

// Lookup table for countries of origin. The Product.country column stays a free-text
// string (for backwards compat with legacy products); new products pick a name from
// this table via the admin searchable select. No FK relation by design.
model Country {
  id    Int    @id @default(autoincrement())
  name  String @unique
  order Int    @default(0)
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String
  sku             String?  // e.g. "WD-EP-100"
  model           String?
  price           Int?
  priceType       String   @default("fixed") // "fixed" | "call"
  availability    String   @default("in_stock") // "in_stock" | "out_of_stock" (varchar, not a number)
  specs           String?  // JSON: Record<string, string> dynamic key-value specs
  discountPercent Float    @default(0) // 0-100
  description     String?  // Full product description (HTML)
  strengths       String?  // JSON array of strings
  weaknesses      String?  // JSON array of strings
  country         String?  // Country of origin name (free-text; new products use Country table)
  warranty        String?  // e.g. "۱ سال گارانتی"
  weight          String?  // e.g. "۱۰۶ گرم"
  productType     String?  // "device" | "material" | "tool" | "consumable"
  typeFields      String?  // JSON: type-specific fields (key/value), all optional
  customSpecs     String?  // JSON: [{label, value}] custom spec rows, all optional
  metaTitle       String?
  metaDescription String?
  keywords        String?  // comma-separated keywords
  categoryId      Int
  category        Category @relation(fields: [categoryId], references: [id])
  brandId         Int
  brand           Brand    @relation(fields: [brandId], references: [id])
  order           Int      @default(0)
  featured        Boolean  @default(false)
  visible         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  images          ProductImage[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  tags            ProductTag[]

  @@index([categoryId])
  @@index([brandId])
  @@index([name])
  @@index([discountPercent])
  @@index([sku])
  @@index([productType])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model User {
  id            Int       @id @default(autoincrement())
  phone         String?   @unique
  email         String?   @unique
  name          String?
  googleId      String?   @unique
  avatar        String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
}

model OTP {
  id         Int       @id @default(autoincrement())
  phone      String
  code       String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?  // e.g. "خانه", "مطعم"
  province   String?
  city       String?
  fullAddress String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("active") // "active" | "converted"
  createdAt DateTime @default(now())
  items     CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  priceAtAdd Int     // Price snapshot at time of adding
  createdAt DateTime @default(now())
}

model Order {
  id             Int      @id @default(autoincrement())
  orderNumber    String   @unique
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  status         String   @default("pending") // pending, confirmed, shipped, delivered, cancelled
  totalPrice     Int      // Total in toman
  paymentMethod  String?  // "online", "cod"
  paymentRef     String?  // Transaction reference
  paymentStatus  String   @default("pending") // pending, paid, failed
  shippingName   String?
  shippingPhone  String
  shippingAddress String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items          OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  productName String  // Snapshot
  quantity    Int
  unitPrice   Int     // Snapshot
  totalPrice  Int

  @@index([orderId])
}

model BlogCategory {
  id    Int        @id @default(autoincrement())
  name  String
  slug  String     @unique
  description String?
  posts BlogPost[]
  order Int        @default(0)
}

model BlogPost {
  id          Int          @id @default(autoincrement())
  title       String
  slug        String       @unique
  excerpt     String
  content     String
  categoryId  Int
  category    BlogCategory @relation(fields: [categoryId], references: [id])
  coverImage  String?
  readTime    Int          @default(5)
  published   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
  @@index([published])
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String
  slug     String       @unique
  type     String       @default("general") // "general" | "consumable" | "feature" | "badge"
  products ProductTag[]
  order    Int          @default(0)
}

model ProductTag {
  productId Int     @default(0)
  tagId     Int     @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String
  detail    String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}