# Database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mesadent_db?schema=public"

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# JWT secret for signing tokens
JWT_SECRET=your_jwt_secret_key_here

# SMS provider: sandbox | arta | sms_ir
SMS_PROVIDER=sandbox

# Arta SMS credentials (from artapayamak.com panel)
ARTA_SMS_API_TOKEN=your_arta_api_token
ARTA_SMS_PATTERN_CODE=your_pattern_code
ARTA_SMS_FROM_NUMBER=+983000505
ARTA_SMS_OTP_PARAMETER=code
